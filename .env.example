# Copy to .env.local for local development, and add the same names in Vercel
# (except DATABASE_URL_UNPOOLED, which only scripts/migrate.mjs uses).
# Only the two Google browser values may be prefixed with NEXT_PUBLIC_.

# --- Written by `neon deploy` / `neon env pull` ---
# Owner connections. The app never uses these; the owner bypasses RLS.
DATABASE_URL=postgresql://neondb_owner:...@ep-example-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:...@ep-example.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production
NEON_AUTH_BASE_URL=https://ep-example.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-example.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json

# --- Added by hand (neon env pull leaves these alone) ---
# Secret. The pooled URL with the mates_app role and its password (see README).
MATES_APP_DATABASE_URL=postgresql://mates_app:...@ep-example-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full
# Secret: signs the session cookies. At least 32 characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Google Cloud: browser key, restricted to your Vercel URL and http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Google Cloud: vector Map ID with the dark style that hides business points of interest
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Secret: server key restricted to Places API (New), for the coordinate refresh
GOOGLE_PLACES_SERVER_KEY=

# Secret: any long random string. Vercel sends it as the cron's Bearer token.
CRON_SECRET=
